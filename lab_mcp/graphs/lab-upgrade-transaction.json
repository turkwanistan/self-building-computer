{
  "name": "lab-upgrade-transaction",
  "version": "1",
  "description": "Restart-safe Lab candidate install, verification, explicit LKG acceptance, and post-update verification transaction.",
  "parameters": {
    "candidate": {"type": "path", "required": true, "absolute": true},
    "generation": {"type": "str", "required": true, "pattern": "[A-Za-z0-9._-]+"},
    "old": {"type": "str", "required": true},
    "new": {"type": "str", "required": true},
    "port": {"type": "int", "default": 8891, "min": 1024, "max": 65535},
    "source": {"type": "path", "default": "/opt/optiplex-lab/server.py", "absolute": true}
  },
  "limits": {
    "max_nodes": 8,
    "max_invocations": 8,
    "max_depth": 1,
    "child_timeout_s": 240
  },
  "nodes": [
    {
      "id": "install-candidate",
      "workflow": "lab-self-evolve@1",
      "depends_on": [],
      "restart_boundary": true,
      "restart_timeout_s": 40,
      "params": {
        "candidate": {"$param": "candidate"},
        "generation": {"$param": "generation"},
        "old": {"$param": "old"},
        "new": {"$param": "new"},
        "port": {"$param": "port"},
        "source": {"$param": "source"}
      }
    },
    {
      "id": "verify-candidate",
      "workflow": "lab-candidate-verify@2",
      "depends_on": ["install-candidate"],
      "attempts": 2,
      "retry_delay_s": 1,
      "params": {}
    },
    {
      "id": "accept-lkg",
      "workflow": "lab-accept-current@2",
      "depends_on": ["verify-candidate"],
      "params": {}
    },
    {
      "id": "post-verify",
      "workflow": "lab-post-update-verify@2",
      "depends_on": ["accept-lkg"],
      "params": {}
    }
  ]
}
